# ── API-Watch — Local Development Environment ──────────────────────
# Copy this file to .env and fill in values as needed.
# All settings have sensible defaults for local development.

# ── General ──────────────────────────────────────────────────────────
# DEBUG=false
# LOG_LEVEL=INFO

# ── Server ───────────────────────────────────────────────────────────
# PORT=8000
# HOST=0.0.0.0
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Database ─────────────────────────────────────────────────────────
# SQLite (default — zero setup):
# DATABASE_URL=sqlite+aiosqlite:///data/apiwatch.db
#
# PostgreSQL (via docker-compose):
# DATABASE_URL=postgresql+asyncpg://apiwatch:apiwatch_dev@localhost:5432/apiwatch
#
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# ── Redis / Cache ────────────────────────────────────────────────────
# Leave empty for in-memory fallback (default):
# REDIS_URL=
#
# Redis (via docker-compose):
# REDIS_URL=redis://localhost:6379/0

# ── JWT / Auth ───────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-secret

# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Rate Limiting ────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=60
# RATE_LIMIT_AUTH=10
# RATE_LIMIT_WINDOW=60

# ── Storage ──────────────────────────────────────────────────────────
# STORAGE_BACKEND=filesystem
# STORAGE_ROOT=data/storage
# AZURE_BLOB_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER=apiwatch
